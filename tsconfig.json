{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "types": ["node"]
  },
  "exclude": ["node_modules/", "test/"],
  "include": ["src/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
